{
  "id": "AttrWf00fAlert01",
  "name": "WF-00f Raise Alert",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "b86a9789-30b0-1955-0c77-01314d8f8f62",
      "name": "When Called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH c AS (SELECT $1::jsonb AS j),\nprev AS (SELECT a.last_notified_at FROM alerts a, c WHERE a.error_signature = c.j->>'error_signature' AND a.status IN ('open','acknowledged')),\nup AS (\nINSERT INTO alerts (location_id, severity, error_signature, workflow_name, node_name, execution_url, entity_type, entity_id, message, suggested_action, last_notified_at)\nSELECT NULLIF(j->>'location_id',''), COALESCE(NULLIF(j->>'severity',''),'WARNING'), j->>'error_signature', j->>'workflow_name', j->>'node_name',\n       j->>'execution_url', NULLIF(j->>'entity_type',''), j->>'entity_id', left(j->>'message', 2000), j->>'suggested_action', now()\nFROM c\nON CONFLICT (error_signature) WHERE status IN ('open','acknowledged')\nDO UPDATE SET occurrence_count = alerts.occurrence_count + 1, last_seen_at = now(),\n              last_notified_at = CASE WHEN alerts.last_notified_at IS NULL OR alerts.last_notified_at < now() - interval '15 minutes' THEN now() ELSE alerts.last_notified_at END\nRETURNING alert_id, severity, occurrence_count\n)\nSELECT up.alert_id, up.severity, up.occurrence_count,\n       (NOT EXISTS (SELECT 1 FROM prev) OR EXISTS (SELECT 1 FROM prev WHERE last_notified_at IS NULL OR last_notified_at < now() - interval '15 minutes')) AS should_notify\nFROM up;",
        "options": {
          "queryReplacement": "={{ [ JSON.stringify($json) ] }}"
        }
      },
      "id": "3544897d-deb0-64a6-426a-c2c6dbef53b0",
      "name": "Raise Alert",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        240,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Attribution Postgres"
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Alert is written to the DB first; Slack is best effort. 15-minute throttle per error_signature."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "e1506afc-ea6f-4eaf-ad38-895fc1b66adf",
              "leftValue": "={{ $json.should_notify === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "6b5729d1-f894-c040-4133-6dd4b3fe0848",
      "name": "Should Notify?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT slack_channel FROM locations WHERE location_id = $1::text;",
        "options": {
          "queryReplacement": "={{ [ String($('When Called').first().json.location_id || '') ] }}"
        }
      },
      "id": "79f5cd77-c0b3-9cf1-0ef3-6ed66ac5febf",
      "name": "Load Slack Channel",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        720,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Attribution Postgres"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "\nconst a = $('When Called').first().json;\nconst r = $('Raise Alert').first().json;\nconst row = $input.first().json || {};\nconst channel = row.slack_channel || $env.SLACK_DEFAULT_CHANNEL || '';\nconst icon = { CRITICAL: ':rotating_light:', WARNING: ':warning:', INFO: ':information_source:' }[a.severity] || ':warning:';\nconst lines = [\n  icon + ' *' + (a.severity || 'WARNING') + '* ' + (a.workflow_name || '') + (a.node_name ? ' / ' + a.node_name : '') + (a.location_id ? '  `' + a.location_id + '`' : ''),\n  String(a.message || '').slice(0, 1500),\n  a.suggested_action ? '_Action:_ ' + a.suggested_action : '',\n  (r.occurrence_count > 1 ? 'Occurrences: ' + r.occurrence_count + '  ' : '') + (a.execution_url ? 'Execution: ' + a.execution_url : '')\n].filter(Boolean);\nreturn [{ json: { channel, text: lines.join('\\n'), has_channel: !!channel } }];\n"
      },
      "id": "e0139edf-ba50-3060-bf31-f6c96f7b41d4",
      "name": "Build Slack Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ]
    },
    {
