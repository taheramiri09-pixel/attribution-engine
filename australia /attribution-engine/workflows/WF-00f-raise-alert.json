              "id": "9cf9fd24-3ee6-4a71-b355-4b9ea54e0a45",
              "leftValue": "={{ $json.has_channel }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "073a223c-e50e-ec6f-6391-41076182f8f9",
      "name": "Has Channel?",
